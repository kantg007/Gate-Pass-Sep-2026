generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One society / office / parking location
model Site {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Dynamic config: limits, feature flags, display labels — change without code deploy
  settings  String   @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lanes        Lane[]
  units        Unit[]
  vehicles     Vehicle[]
  credentials  AccessCredential[]
  visitorPasses VisitorPass[]
  events       AccessEvent[]
}

model Lane {
  id           String  @id @default(cuid())
  siteId       String
  name         String
  /// ENTRY | EXIT | BOTH — stored as string for easy extension
  direction    String  @default("ENTRY")
  /// IoT box uses this key in X-Device-Key header
  deviceApiKey String  @unique
  isActive     Boolean @default(true)
  /// Extra per-lane config (relay pulse ms, etc.)
  config       String  @default("{}")

  site   Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  events AccessEvent[]

  @@index([siteId])
}

model Unit {
  id     String  @id @default(cuid())
  siteId String
  label  String
  block  String?
  floor  String?
  meta   String  @default("{}")

  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vehicles      Vehicle[]
  visitorPasses VisitorPass[]

  @@unique([siteId, label])
  @@index([siteId])
}

model Vehicle {
  id          String  @id @default(cuid())
  siteId      String
  unitId      String?
  plateNumber String
  label       String?
  isActive    Boolean @default(true)
  meta        String  @default("{}")

  site         Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  unit         Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  credentials  AccessCredential[]

  @@unique([siteId, plateNumber])
  @@index([siteId])
}

/// RFID / QR / BARCODE / future types — type is a free string for flexibility
model AccessCredential {
  id            String    @id @default(cuid())
  siteId        String
  /// RFID | QR | BARCODE | ...
  type          String
  /// Tag UID or QR/barcode payload
  code          String
  vehicleId     String?
  visitorPassId String?   @unique
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  meta          String    @default("{}")
  createdAt     DateTime  @default(now())

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  visitorPass VisitorPass? @relation(fields: [visitorPassId], references: [id], onDelete: Cascade)

  @@unique([siteId, type, code])
  @@index([siteId, code])
}

model VisitorPass {
  id        String   @id @default(cuid())
  siteId    String
  unitId    String?
  guestName String
  purpose   String?
  maxUses   Int      @default(2)
  usedCount Int      @default(0)
  validFrom DateTime @default(now())
  validUntil DateTime
  isActive  Boolean  @default(true)
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  site       Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  unit       Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  credential AccessCredential?

  @@index([siteId])
}

model AccessEvent {
  id             String   @id @default(cuid())
  siteId         String
  laneId         String?
  credentialType String?
  credentialCode String?
  /// ALLOW | DENY
  decision       String
  reason         String
  vehicleId      String?
  plateNumber    String?
  meta           String   @default("{}")
  createdAt      DateTime @default(now())

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  lane Lane? @relation(fields: [laneId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([laneId])
}
